# ── База данных ─────────────────────────────────────────────────────────
# Self-hosted вариант (docker-compose.yml на том же VPS):
DATABASE_URL="postgresql://umelo:CHANGE_ME@localhost:5432/umelo"
POSTGRES_PASSWORD="CHANGE_ME"

# ── Redis (дневной лимит откликов, рейтинг блогеров, real-time чат) ──────
REDIS_URL="redis://:CHANGE_ME@localhost:6379"
REDIS_PASSWORD="CHANGE_ME"

# ── Объектное хранилище для фото/видео/документов (S3-совместимое) ──────
# Яндекс Object Storage или Selectel S3 — оба работают с обычным S3 SDK,
# просто меняется ENDPOINT. Бакет НЕ публичный — доступ через presigned URL.
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="umelo-media"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"

# ── Авторизация ───────────────────────────────────────────────────────────
# Секрет для подписи JWT/сессий — сгенерировать: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# SMS-провайдер для входа по телефону (типично для российского рынка) —
# например SMS.ru, SMSC.ru или Green SMS. Один из вариантов на старте.
SMS_PROVIDER_API_KEY="CHANGE_ME"
